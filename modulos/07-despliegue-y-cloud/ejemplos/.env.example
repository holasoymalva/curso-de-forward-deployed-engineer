# ==============================================================================
# .env.example - Plantilla de variables de entorno (Nexo - Proyecto Halcón)
# Copia este archivo a .env y define los valores reales: cp .env.example .env
# ==============================================================================

# Entorno de ejecución: desarrollo | staging | produccion
ENTORNO=desarrollo

# Configuración de red de la API
API_BASE_URL=http://api-halcon:8000
PUERTO=8000

# Credenciales de autenticación máquina a máquina (M2M)
CLIENT_ID=nexo-demo
CLIENT_SECRET=secreto-de-practica

# Base de datos persistente
DB_PATH=/app/datos/halcon.db

# Parámetros de resiliencia
MAX_REINTENTOS=5
TIMEOUT_SEG=10
INTERVALO_SYNC_SEG=60

# Secreto para validación de firmas criptográficas HMAC en Webhooks
WEBHOOK_SECRET=secreto-seguro-halcon-nexo-2026
