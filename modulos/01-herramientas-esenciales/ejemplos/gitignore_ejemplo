# --- Entornos Virtuales y Dependencias Locales ---
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# --- Compilación y cachés de Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

